# sig/operations.rbs

module Operations
  class Create
    def self.call: (admin_user: AdminUser, kind: String, ?retry_of: Operation?) -> Operation
  end

  class Serializer
    def initialize: (Operation operation) -> void
    def as_json: (*untyped) -> Hash[Symbol, untyped]
  end

  class Transition
    def self.call: (operation: Operation, state: String, progress: Integer, message: String, ?result: String?, ?error: String?) -> OperationEvent
  end
end

module Showcase
  module Telemetry
    class RequestStore
      def record: (duration_ms: Numeric, status: Integer) -> untyped
      def samples: () -> Array[Hash[String, untyped]]
    end

    class Snapshot
      def as_json: (*untyped) -> Hash[Symbol, untyped]
    end
  end
end
