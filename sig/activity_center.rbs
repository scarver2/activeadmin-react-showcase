# sig/activity_center.rbs

module ActivityCenter
  class Serializer
    def initialize: (Noticed::Notification notification) -> void
    def as_json: (*untyped) -> Hash[Symbol, untyped]
  end

  class Create
    def self.call: (admin_user: AdminUser, attributes: Hash[Symbol, untyped], ?enqueue_delivery: bool) -> Noticed::Notification
  end

  class Seed
    def self.call: (admin_user: AdminUser) -> ActiveRecord::Relation
  end

  class UnreadProjection
    def self.broadcast: (AdminUser admin_user) -> untyped
    def self.envelope: (AdminUser admin_user) -> Hash[Symbol, untyped]
  end


  class SetReadState
    def self.call: (notification: Noticed::Notification, read: bool) -> Noticed::Notification
  end
end
