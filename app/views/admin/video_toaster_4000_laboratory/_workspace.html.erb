<%# app/views/admin/video_toaster_4000_laboratory/_workspace.html.erb %>
<% slots = ActiveAdmin::Themes::VideoToaster4000::COMPOSITION.slots %>
<section class="<%= slots.fetch(:workspace) %>" aria-label="Video Toaster 4000 design study">
  <header class="<%= slots.fetch(:screen_header) %>">
    <span><strong>VIDEO TOASTER 4000 · 3.1</strong></span>
    <span>LIGHTWAVE 3D 3.5 · AMIGA</span>
    <span>HERITAGE LAB / 08</span>
  </header>
  <nav class="<%= slots.fetch(:navigation) %>" aria-label="Video Toaster 4000 application navigation">
    <%= link_to "Dashboard", admin_root_path %>
    <%= link_to "Main · Accounts", admin_accounts_path %>
    <%= link_to "Preview · Data", admin_data_explorer_path %>
    <a href="#video-toaster-4000-controls">Controls</a>
    <a href="#video-toaster-4000-about">Provenance</a>
  </nav>

  <div>
    <nav class="<%= slots.fetch(:launcher_group) %>" aria-label="Video production application launchers">
      <%= link_to admin_accounts_path, class: slots.fetch(:launcher) do %>
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Accounts</span>
      <% end %>
      <%= link_to admin_data_explorer_path, class: slots.fetch(:launcher) do %>
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Data Explorer</span>
      <% end %>
      <a href="#video-toaster-4000-controls" class="<%= slots.fetch(:launcher) %>">
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Control Surface</span>
      </a>
      <p>PRODUCTION TOOLS<br><small>Rails-owned destinations</small></p>
    </nav>

    <div class="<%= slots.fetch(:workspace_grid) %>">
      <section class="<%= [slots.fetch(:window), slots.fetch(:primary_window)].join(" ") %>" aria-labelledby="video-toaster-4000-accounts-title">
        <h2 class="<%= slots.fetch(:window_header) %>" id="video-toaster-4000-accounts-title"><span>Main Bus · Account Records</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p class="<%= slots.fetch(:status) %>" role="status"><strong><%= pluralize(accounts.length, "record") %></strong> · <%= status || "all statuses" %> · read-only</p>
          <div class="<%= slots.fetch(:data_region) %>" role="region" aria-label="Account records" tabindex="0">
            <table class="<%= slots.fetch(:data_table) %>">
              <caption>First eight matching accounts, ordered by name</caption>
              <thead><tr><th scope="col">Name</th><th scope="col">Plan</th><th scope="col">Region</th><th scope="col">Status</th></tr></thead>
              <tbody>
                <% accounts.each do |account| %>
                  <tr>
                    <th scope="row"><%= link_to account.name, admin_account_path(account) %></th>
                    <td><%= account.plan %></td><td><%= account.region %></td>
                    <td><span class="<%= slots.fetch(:status_tag) %>"><%= account.status %></span></td>
                  </tr>
                <% end %>
                <% if accounts.empty? %>
                  <tr><td colspan="4">No accounts match this view. Reset the controls to show all accounts.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="<%= slots.fetch(:window_actions) %>"><%= link_to "Open Accounts application →", admin_accounts_path %></p>
        </div>
      </section>

      <section class="<%= [slots.fetch(:window), slots.fetch(:side_window)].join(" ") %>" id="video-toaster-4000-controls" aria-labelledby="video-toaster-4000-controls-title" tabindex="-1">
        <h2 class="<%= slots.fetch(:window_header) %>" id="video-toaster-4000-controls-title"><span>Preview Bus · Record Filter</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p>Choose which account records appear in the main data view.</p>
          <%= form_with url: admin_video_toaster_4000_laboratory_path, method: :get, local: true, class: slots.fetch(:form) do |form| %>
            <%= form.label :status, "Account status" %>
            <%= form.select :status, [["All statuses", ""]] + Account::STATUSES.map { |value| [value, value] }, selected: status %>
            <p class="<%= slots.fetch(:help) %>">Display control only. No records are changed.</p>
            <div class="<%= slots.fetch(:actions) %>">
              <%= form.submit "Route View", class: slots.fetch(:primary_action) %>
              <%= link_to "Reset", admin_video_toaster_4000_laboratory_path, class: slots.fetch(:secondary_action) %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="<%= [slots.fetch(:window), slots.fetch(:wide_window)].join(" ") %>" id="video-toaster-4000-about" aria-labelledby="video-toaster-4000-about-title" tabindex="-1">
        <h2 class="<%= slots.fetch(:window_header) %>" id="video-toaster-4000-about-title"><span>Mode · Provenance Workbench</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p><strong>A composed production control surface.</strong> This laboratory translates the visual hierarchy of a Video Toaster 4000 and period LightWave workspace onto ordinary ActiveAdmin records while Rails remains behavioral authority.</p>
          <details>
            <summary>Reference, provenance &amp; modern adaptations</summary>
            <p>The gem supplies the complete presentation and all 24 semantic roles. Showcase adds no theme variables, composition selectors, historical source, screenshots, icons, fonts, marks, video hardware behavior, or 3D runtime emulation. Native links, table semantics, GET controls, local overflow, visible focus, forced-colors support, and responsive reflow preserve modern access expectations.</p>
          </details>
        </div>
      </section>
    </div>
    <footer class="<%= slots.fetch(:footer) %>"><span>VIEW: <%= status || "ALL" %> · <%= accounts.length %> OF 8 MAX</span><span>AA4 behavior · Video Toaster 4000 / LightWave visual study</span></footer>
  </div>
</section>
