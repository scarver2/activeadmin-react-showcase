<%# app/views/admin/amigaos_4_laboratory/_workspace.html.erb %>
<% slots = ActiveAdmin::Themes::AmigaOS4::COMPOSITION.slots %>
<section class="<%= slots.fetch(:workspace) %>" aria-label="AmigaOS 4 design study">
  <header class="<%= slots.fetch(:screen_header) %>">
    <span><strong>AmigaOS 4.1 FE</strong></span>
    <span>Accounts · Workbench Screen</span>
    <span>HERITAGE LAB / 05</span>
  </header>
  <nav class="<%= slots.fetch(:navigation) %>" aria-label="AmigaOS 4 application navigation">
    <%= link_to "Workbench", admin_root_path %>
    <%= link_to "Accounts", admin_accounts_path %>
    <%= link_to "MUI", admin_mui_laboratory_path %>
    <a href="#amigaos-4-controls">Controls</a>
    <a href="#amigaos-4-about">About</a>
  </nav>

  <div>
    <nav class="<%= slots.fetch(:launcher_group) %>" aria-label="AmiDock-style application launchers">
      <%= link_to admin_accounts_path, class: slots.fetch(:launcher) do %>
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Accounts</span>
      <% end %>
      <%= link_to admin_data_explorer_path, class: slots.fetch(:launcher) do %>
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Reports</span>
      <% end %>
      <a href="#amigaos-4-controls" class="<%= slots.fetch(:launcher) %>">
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Prefs</span>
      </a>
      <p>AMIDOCK<br><small>Rails-owned destinations</small></p>
    </nav>

    <div class="<%= slots.fetch(:workspace_grid) %>">
      <section class="<%= [slots.fetch(:window), slots.fetch(:primary_window)].join(" ") %>" aria-labelledby="amigaos-4-accounts-title">
        <h2 class="<%= slots.fetch(:window_header) %>" id="amigaos-4-accounts-title"><span>Accounts — ReAction List</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p class="<%= slots.fetch(:status) %>" role="status"><strong><%= pluralize(accounts.length, "record") %></strong> · <%= status || "all statuses" %> · read-only</p>
          <div class="<%= slots.fetch(:data_region) %>" role="region" aria-label="Account records" tabindex="0">
            <table class="<%= slots.fetch(:data_table) %>">
              <caption>First eight matching accounts, ordered by name</caption>
              <thead><tr><th scope="col">Name</th><th scope="col">Plan</th><th scope="col">Region</th><th scope="col">Status</th></tr></thead>
              <tbody>
                <% accounts.each do |account| %>
                  <tr>
                    <th scope="row"><%= link_to account.name, admin_account_path(account) %></th>
                    <td><%= account.plan %></td><td><%= account.region %></td>
                    <td><span class="<%= slots.fetch(:status_tag) %>"><%= account.status %></span></td>
                  </tr>
                <% end %>
                <% if accounts.empty? %>
                  <tr><td colspan="4">No accounts match these controls. Reset the view to show all accounts.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="<%= slots.fetch(:window_actions) %>"><%= link_to "Open Accounts application →", admin_accounts_path %></p>
        </div>
      </section>

      <section class="<%= [slots.fetch(:window), slots.fetch(:side_window)].join(" ") %>" id="amigaos-4-controls" aria-labelledby="amigaos-4-controls-title" tabindex="-1">
        <h2 class="<%= slots.fetch(:window_header) %>" id="amigaos-4-controls-title"><span>View Controls</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p>Choose which account records appear in the list.</p>
          <%= form_with url: admin_amigaos_4_laboratory_path, method: :get, local: true, class: slots.fetch(:form) do |form| %>
            <%= form.label :status, "Account status" %>
            <%= form.select :status, [["All statuses", ""]] + Account::STATUSES.map { |value| [value, value] }, selected: status %>
            <p class="<%= slots.fetch(:help) %>">Display control only. No records are changed.</p>
            <div class="<%= slots.fetch(:actions) %>">
              <%= form.submit "Apply", class: slots.fetch(:primary_action) %>
              <%= link_to "Reset", admin_amigaos_4_laboratory_path, class: slots.fetch(:secondary_action) %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="<%= [slots.fetch(:window), slots.fetch(:wide_window)].join(" ") %>" id="amigaos-4-about" aria-labelledby="amigaos-4-about-title" tabindex="-1">
        <h2 class="<%= slots.fetch(:window_header) %>" id="amigaos-4-about-title"><span>About This ReAction Study</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p><strong>A high-color shared-screen workspace.</strong> Pearl surfaces, cool-blue active windows, compact ReAction groups, and dock-like launchers distinguish this generation from classic Workbench and MUI while Rails remains behavioral authority.</p>
          <details>
            <summary>Reference, provenance &amp; modern adaptations</summary>
            <p>The gem supplies the complete fixed-light presentation and all 24 semantic roles. Showcase adds no theme variables, composition selectors, historical artwork, fonts, icons, or runtime emulation. Native links, table semantics, GET controls, local overflow, visible focus, and responsive reflow preserve modern access expectations.</p>
          </details>
        </div>
      </section>
    </div>
    <footer class="<%= slots.fetch(:footer) %>"><span>Ready.</span><span>AA4 behavior · AmigaOS 4 visual study · fixed light baseline</span></footer>
  </div>
</section>
