<%# app/views/admin/conversations/_inbox_fallback.html.erb %>
<div class="panel" data-conversation-fallback="inbox">
  <h3>Inbox</h3>
  <div class="panel_contents">
    <p><%= link_to "View saved messages", saved_admin_conversations_path %></p>
    <p>Authenticated conversations are ordered by their latest durable activity.</p>

    <% if memberships.any? %>
      <ol aria-label="Conversation inbox">
        <% memberships.each do |entry| %>
          <% membership = entry.membership %>
          <% conversation = membership.conversation %>
          <li>
            <h4><%= link_to conversation.title, admin_conversation_path(conversation.public_id) %></h4>
            <% if conversation.topic.present? %><p><%= conversation.topic %></p><% end %>
            <p>
              <%= pluralize(entry.unread_count, "unread message") %>
              · Last activity <%= time_tag conversation.last_activity_at %>
            </p>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p role="status">You do not belong to any conversations yet.</p>
    <% end %>
  </div>
</div>
