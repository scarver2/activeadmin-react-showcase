<%# app/views/admin/haiku_beta6_laboratory/_workspace.html.erb %>
<% slots = ActiveAdmin::Themes::HaikuBeta6::COMPOSITION.slots %>
<section class="<%= slots.fetch(:workspace) %>" aria-label="Haiku beta6 design study">
  <header class="<%= slots.fetch(:screen_header) %>">
    <span><strong>Haiku · R1/beta6</strong></span>
    <span>Accounts · Tracker Workspace</span>
    <span>HERITAGE LAB / 07</span>
  </header>
  <nav class="<%= slots.fetch(:navigation) %>" aria-label="Haiku beta6 application navigation">
    <%= link_to "Tracker", admin_root_path %>
    <%= link_to "Accounts", admin_accounts_path %>
    <%= link_to "AROS/Zune", admin_aros_zune_laboratory_path %>
    <a href="#haiku-beta6-controls">Appearance</a>
    <a href="#haiku-beta6-about">About</a>
  </nav>

  <div>
    <nav class="<%= slots.fetch(:launcher_group) %>" aria-label="Haiku application launchers">
      <%= link_to admin_accounts_path, class: slots.fetch(:launcher) do %>
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Accounts</span>
      <% end %>
      <%= link_to admin_data_explorer_path, class: slots.fetch(:launcher) do %>
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Reports</span>
      <% end %>
      <a href="#haiku-beta6-controls" class="<%= slots.fetch(:launcher) %>">
        <span class="<%= slots.fetch(:launcher_art) %>" aria-hidden="true"></span><span>Appearance</span>
      </a>
      <p>APPLICATIONS<br><small>Rails-owned destinations</small></p>
    </nav>

    <div class="<%= slots.fetch(:workspace_grid) %>">
      <section class="<%= [slots.fetch(:window), slots.fetch(:primary_window)].join(" ") %>" aria-labelledby="haiku-beta6-accounts-title">
        <h2 class="<%= slots.fetch(:window_header) %>" id="haiku-beta6-accounts-title"><span>Accounts · list view</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p class="<%= slots.fetch(:status) %>" role="status"><strong><%= pluralize(accounts.length, "record") %></strong> · <%= status || "all statuses" %> · read-only</p>
          <div class="<%= slots.fetch(:data_region) %>" role="region" aria-label="Account records" tabindex="0">
            <table class="<%= slots.fetch(:data_table) %>">
              <caption>First eight matching accounts, ordered by name</caption>
              <thead><tr><th scope="col">Name</th><th scope="col">Plan</th><th scope="col">Region</th><th scope="col">Status</th></tr></thead>
              <tbody>
                <% accounts.each do |account| %>
                  <tr>
                    <th scope="row"><%= link_to account.name, admin_account_path(account) %></th>
                    <td><%= account.plan %></td><td><%= account.region %></td>
                    <td><span class="<%= slots.fetch(:status_tag) %>"><%= account.status %></span></td>
                  </tr>
                <% end %>
                <% if accounts.empty? %>
                  <tr><td colspan="4">No accounts match this view. Reset the controls to show all accounts.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="<%= slots.fetch(:window_actions) %>"><%= link_to "Open Accounts application →", admin_accounts_path %></p>
        </div>
      </section>

      <section class="<%= [slots.fetch(:window), slots.fetch(:side_window)].join(" ") %>" id="haiku-beta6-controls" aria-labelledby="haiku-beta6-controls-title" tabindex="-1">
        <h2 class="<%= slots.fetch(:window_header) %>" id="haiku-beta6-controls-title"><span>View Controls</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p>Choose which account records appear in the list.</p>
          <%= form_with url: admin_haiku_beta6_laboratory_path, method: :get, local: true, class: slots.fetch(:form) do |form| %>
            <%= form.label :status, "Account status" %>
            <%= form.select :status, [["All statuses", ""]] + Account::STATUSES.map { |value| [value, value] }, selected: status %>
            <p class="<%= slots.fetch(:help) %>">Display control only. No records are changed.</p>
            <div class="<%= slots.fetch(:actions) %>">
              <%= form.submit "Apply", class: slots.fetch(:primary_action) %>
              <%= link_to "Reset", admin_haiku_beta6_laboratory_path, class: slots.fetch(:secondary_action) %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="<%= [slots.fetch(:window), slots.fetch(:wide_window)].join(" ") %>" id="haiku-beta6-about" aria-labelledby="haiku-beta6-about-title" tabindex="-1">
        <h2 class="<%= slots.fetch(:window_header) %>" id="haiku-beta6-about-title"><span>About This Haiku Study</span></h2>
        <div class="<%= slots.fetch(:window_content) %>">
          <p><strong>A clear, concise utility workspace.</strong> The blue desktop field, gray utility surfaces, white document well, partial-width yellow active tabs, and compact Tracker-inspired geometry translate Haiku beta6's visual hierarchy while Rails remains behavioral authority.</p>
          <details>
            <summary>Reference, provenance &amp; modern adaptations</summary>
            <p>The gem supplies the complete fixed-light presentation and all 24 semantic roles. Showcase adds no theme variables, composition selectors, Haiku source, screenshots, icons, fonts, marks, window-manager behavior, or runtime emulation. Native links, table semantics, GET controls, local overflow, visible focus, forced-colors support, and responsive reflow preserve modern access expectations.</p>
          </details>
        </div>
      </section>
    </div>
    <footer class="<%= slots.fetch(:footer) %>"><span>Ready.</span><span>AA4 behavior · Haiku beta6 visual study · fixed light baseline</span></footer>
  </div>
</section>
