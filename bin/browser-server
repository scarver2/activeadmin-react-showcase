#!/usr/bin/env bash
# bin/browser-server

source "$(dirname "$0")/_lib.sh"

export RAILS_ENV=test
# Force Vite Ruby to consume the deterministic test build. Without CI set,
# any unrelated process listening on Vite's shared test port is mistaken for
# this worktree's development server and Rails proxies assets to the wrong
# process.
export CI=1
export ACTIVE_JOB_QUEUE_ADAPTER=solid_queue
export SHOWCASE_OPERATION_STEP_DELAY="${SHOWCASE_OPERATION_STEP_DELAY:-0.6}"
export SHOWCASE_TERMINAL_STEP_DELAY="${SHOWCASE_TERMINAL_STEP_DELAY:-0.6}"
export SHOWCASE_ADMIN_EMAIL="${SHOWCASE_ADMIN_EMAIL:-admin@example.test}"
export SHOWCASE_ADMIN_PASSWORD="${SHOWCASE_ADMIN_PASSWORD:-showcase-password}"
export SOLID_CABLE_IN_TEST=1
export SOLID_QUEUE_IN_PUMA=1

run bundle exec rails db:reset
run bundle exec vite build --mode test
run_exec bundle exec rails server --binding 127.0.0.1 --port "${PORT:-3100}"
